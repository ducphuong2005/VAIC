# Copy to .env and fill local secrets.

SERVER_PORT=8080

DB_HOST=localhost
DB_PORT=3306
DB_NAME=career_compass
DB_USERNAME=root
DB_PASSWORD=123456
MYSQL_ROOT_PASSWORD=123456

JWT_SECRET=dev-only-change-this-secret-at-least-32-bytes-long
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=14
INTERNAL_CRAWLER_API_KEY=dev-crawler-api-key-change-me
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5500,http://127.0.0.1:5500,null

LLM_PROVIDER=gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=replace-with-your-gemini-api-key
LLM_MODEL=gemini-flash-lite-latest
LLM_CONTEXT_MODEL=gemini-flash-lite-latest
LLM_ANSWER_MODEL=gemini-flash-latest
LLM_TIMEOUT_SECONDS=30

REC_WEIGHT_INTEREST=0.25
REC_WEIGHT_ABILITY=0.25
REC_WEIGHT_SKILL=0.15
REC_WEIGHT_WORK_STYLE=0.10
REC_WEIGHT_MARKET=0.15
REC_WEIGHT_FEASIBILITY=0.10
